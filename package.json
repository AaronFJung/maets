{
	"name": "maets-root",
	"version": "0.1.0-alpha.0",
	"private": true,
	"workspaces": [
		"next",
		"maets-game-sync",
		"maets-games"
	],
	"scripts": {
		"dev": "npm run dev --workspace maets",
		"build": "npm run build --workspace maets",
		"start": "npm run start --workspace maets",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"preversion": "npm run lint",
		"postversion": "git push --follow-tags",
		"release:preminor": "npm version preminor --preid=alpha",
		"release:alpha": "npm version prerelease --preid=alpha",
		"release:beta": "npm version prerelease --preid=beta",
		"release:rc": "npm version prerelease --preid=rc",
		"release:finalize": "npm version patch"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6"
	}
}
